{
  "name": "hydratact-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HydraTact Samarinda - Zero-Hardware Dependency Fire Coordination Platform",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "export:openapi": "pnpm --filter @hydratact/backend-api export:openapi",
    "codegen:web": "node scripts/codegen-web.mjs",
    "codegen:mobile": "node scripts/codegen-dart.mjs",
    "codegen": "pnpm codegen:web && pnpm codegen:mobile",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0"
  }
}
